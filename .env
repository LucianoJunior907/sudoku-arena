# ============================================
# Sudoku Arena — Variáveis de Ambiente
# ============================================
# Preencha os valores do Supabase abaixo.
# NÃO cole credenciais no chat — edite este arquivo diretamente.
#
# Como obter:
# 1. Acesse https://supabase.com e crie um projeto (free tier)
# 2. Vá em Project Settings → API
# 3. Copie "Project URL" e "anon public key"
# 4. Cole abaixo (substitua os valores entre aspas)
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="COLE-SUA-ANON-KEY-AQUI"

# --- Banco de dados local (Prisma — já configurado) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db
